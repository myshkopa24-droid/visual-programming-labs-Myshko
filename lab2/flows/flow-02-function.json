        "name": "Обработка данных",
        "func": "// 1. Создаем массив данных\nconst scores = [10, 25, 40, 15, 30];\nlet totalSum = 0;\n\n// 2. Цикл for для подсчета суммы\nfor (let i = 0; i < scores.length; i++) {\n    totalSum += scores[i];\n}\n\n// 3. Условие if/else\nlet status = \"\";\nif (totalSum > 100) {\n    status = \"Высокий результат\";\n} else {\n    status = \"Нормальный результат\";\n}\n\n// 4. Формируем итоговый объект и возвращаем его в msg.payload\nmsg.payload = {\n    user: \"Myshko\",\n    scoresList: scores,\n    sum: totalSum,\n    statusResult: status,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
