        "z": "d9dcc49d7bff961f",
        "name": "function 2",
        "func": "// Получаем текущее значение счетчика из контекста flow (если его нет, ставим 0)\nlet count = flow.get(\"click_count\") || 0;\n\n// Увеличиваем счетчик на 1\ncount += 1;\n\n// Сохраняем новое значение обратно в контекст flow\nflow.set(\"click_count\", count);\n\n// Передаем результат дальше в msg.payload\nmsg.payload = {\n    message: \"Клик успешно засчитан!\",\n    total_clicks: count\n};\n\nreturn msg;",
