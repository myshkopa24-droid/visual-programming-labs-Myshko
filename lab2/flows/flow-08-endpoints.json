    {
        "id": "05c11cf3fc972e76",
        "type": "function",
        "z": "d9dcc49d7bff961f",
        "name": "function 3",
        "func": "// Получаем параметр \"id\" из URL (например, /api/items?id=5)\nconst id = msg.req.query.id;\n\nif (!id) {\n    // Если параметр id не передан — ошибка 400 Bad Request\n    msg.statusCode = 400;\n    msg.payload = { error: \"Ошибка: укажите параметр id (например, ?id=1)\" };\n} else if (id === \"1\") {\n    // Успешный ответ для id=1\n    msg.statusCode = 200;\n    msg.payload = { id: 1, item: \"Кофе Арабика\", status: \"В наличии\" };\n} else {\n    // Если id не найден — ошибка 404 Not Found\n    msg.statusCode = 404;\n    msg.payload = { error: `Товар с id=${id} не найден` };\n}\n\nreturn msg;",
        "outputs": 1,
